# ==========================================
# tmail - Backend Environment Configuration
# ==========================================

# Server port (default: 8080)
PORT=8080

# Environment mode: development | production
ENV=development

# Domain for generated temporary mailboxes
DOMAIN=yourdomain.com

# ------------------------------------------
# mailer-go Upstream Integration
# Get your API key at: https://mailer.lukaulcar.com/
# ------------------------------------------
MAILER_API_KEY=your_mailer_api_key_here
MAILER_API_URL=https://api.mailer.lukaulcar.com

# ------------------------------------------
# Database & Retention Settings
# ------------------------------------------
# Path to SQLite database file
DB_PATH=tmail.db

# Message retention time in hours (default: 24)
MAIL_TTL_HOURS=24

# Mailbox lifetime in hours before expiration (default: 24)
MAILBOX_TTL_HOURS=24

# Cooldown period in minutes before a released mailbox username can be re-allocated (default: 15)
MAILBOX_COOLDOWN_MINUTES=15
